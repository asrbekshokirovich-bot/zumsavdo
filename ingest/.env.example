# ---------------------------------------------------------------- baza
# O'lchovlar shu yerga yoziladi. Service role kaliti RLS dan o'tadi va
# HECH QACHON brauzerga tushmasligi kerak — u faqat shu yig'uvchida.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------------------------------------------------------------- manba
# sample       — namuna o'lchovlari, quvurni tekshirish uchun
# uzum-catalog — Uzum katalogi (ruxsat talab qiladi)
ZUMSAVDO_SOURCE=sample

# ---------------------------------------------------------------- katalog
# Katalog anonim token bilan ishlaydi — token id.uzum.uz/api/auth/token dan
# avtomatik olinadi, qo'lda hech narsa kerak emas.
UZUM_CATALOG_ENDPOINT=https://graphql.uzum.uz/
UZUM_LANGUAGE=uz-UZ
# Har ishchi uchun barqaror bo'lishi kerak (o'rnatma identifikatori).
UZUM_INSTALLATION_ID=3f1a9c22-7b64-4d18-9f0e-2c5a8e1b4d70
# Odatda kerak emas — token va standart sarlavhalar avtomatik qo'yiladi.
UZUM_CATALOG_HEADERS={}

# Qaysi obyektlar kuzatiladi (vergul bilan).
ZUMSAVDO_TRACK_SHOPS=
ZUMSAVDO_TRACK_CATEGORIES=
ZUMSAVDO_TRACK_PRODUCTS=

# ---------------------------------------------------------------- seller API
# O'z do'koningiz uchun rasmiy yo'l. Token seller.uzum.uz kabinetida olinadi.
UZUM_SELLER_ENDPOINT=https://api-seller.uzum.uz
UZUM_SELLER_TOKEN=
UZUM_SELLER_SHOP_ID=

# ---------------------------------------------------------------- tezlik
# Sekundiga bitta so'rov. Tez bo'lsa search-gateway 429 qaytaradi va
# bir necha daqiqa sovushi kerak — bu amalda tekshirilgan.
ZUMSAVDO_RPS=1
ZUMSAVDO_MAX_RETRIES=4
ZUMSAVDO_TIMEOUT_MS=20000
ZUMSAVDO_ROLLUP_DAYS=2

# Bazaga yozmasdan sinash
ZUMSAVDO_DRY_RUN=0

# ---------------------------------------------------------------- namuna manba
ZUMSAVDO_SAMPLE_SHOPS=8
ZUMSAVDO_SAMPLE_PRODUCTS_PER_SHOP=6
ZUMSAVDO_SAMPLE_DAYS=21
ZUMSAVDO_SAMPLE_SWEEPS_PER_DAY=12
