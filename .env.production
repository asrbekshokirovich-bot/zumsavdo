# Ishlab chiqarish uchun ombor manzili.
#
# Bu kalit ATAYLAB omborda turibdi. U `sb_publishable_` — Supabase uni
# aynan brauzerga berish uchun beradi va u har qanday holatda yig'ilgan
# JS ichiga tushadi. Yashirishning imkoni ham, ma'nosi ham yo'q.
#
# Xavfsizlik kalitda emas, HUQUQLARDA. Tekshirilgan:
#
#   zumsavdo xom jadvallari (perepis, kuzatuv, xom o'lchov)  -> 404
#   xom ko'rinishlar (zs_product, zs_tracked_product, ...)   -> 401
#   yozadigan funksiyalar (zs_ingest_batch, zs_record_*, ...) -> 401/404
#   panel ko'rinishlari va yig'indi funksiyalari              -> 200
#
# Ya'ni bu kalit bilan faqat panel ko'rsatadigan yig'indilarni o'qish
# mumkin. Boshqa hech narsa.
#
# Yig'uvchining `service_role` kaliti BUTUNLAY boshqa narsa va u hech
# qachon bu yerga yozilmaydi — faqat ingest/.env da.
#
# Kalitni almashtirish kerak bo'lsa: Supabase -> Settings -> API Keys ->
# publishable kalitni yangilang va shu faylni yangilab suring.
VITE_SUPABASE_URL=https://duequijnnzcngzzvjqst.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_KzLAuxJYrA66iD4lMp7V-g_1GYLuNzL
